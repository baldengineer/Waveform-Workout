#include <zephyr/dt-bindings/dma/stm32_dma.h>

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,display = &trainer_oled;
	};
};

&eeprom { status = "okay"; };

&zephyr_i2c {
	trainer_oled_alt: ssd1306@3c {
		reg = <0x3c>;
		#include "oled-panel.dtsi"
	};
	trainer_oled: ssd1306@3d {
		reg = <0x3d>;
		#include "oled-panel.dtsi"
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc-acm-uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "Waveform Workout shell";
		tx-fifo-size = <256>;
		rx-fifo-size = <256>;
	};
};

/* Expose the timer pin states. The application owns the timers directly. */
&pwm_a { status = "okay"; };
&pwm_b { status = "okay"; };

/* TIM2 compare events feed the two PWM preload registers halfway through
 * each period. RM0376 table 51 maps CC3 and CC4 to request 8.
 */
&timers2 {
	dmas = <&dma1 1 8 (STM32_DMA_PERIPH_TX | STM32_DMA_MEM_8BITS | STM32_DMA_PERIPH_16BITS |
			   STM32_DMA_MODE_CYCLIC)>,
	       <&dma1 4 8 (STM32_DMA_PERIPH_TX | STM32_DMA_MEM_8BITS | STM32_DMA_PERIPH_16BITS |
			   STM32_DMA_MODE_CYCLIC)>;
	dma-names = "pulse", "marker";
};
