/* SPDX-License-Identifier: MIT */
/* One physical display. Boot selects the instance with the saved strap address. */
compatible = "solomon,ssd1306";
zephyr,deferred-init;
ready-time-ms = <100>;
width = <128>;
height = <64>;
multiplex-ratio = <63>;
segment-offset = <0>;
page-offset = <0>;
display-offset = <0>;
segment-remap;
com-invdir;
prechargep = <0x22>;
