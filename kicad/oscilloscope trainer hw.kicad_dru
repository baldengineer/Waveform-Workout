(version 1)

# JLCPCB rigid four-layer FR-4, 1 oz outer copper, routed board edges.
# https://jlcpcb.com/capabilities/pcb-capabilities (checked 2026-11-22)
# The project sets the general track/space floor and routing netclasses.

(rule "JLC routed edge to copper"
    (constraint edge_clearance (min 0.20mm)))

(rule "JLC SMD pad to SMD pad"
    (condition "A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
    (constraint clearance (min 0.15mm)))

(rule "JLC pad to track"
    (condition "A.Type == 'Pad' && (B.Type == 'Track' || B.Type == 'Arc')")
    (constraint clearance (min 0.10mm)))

(rule "JLC through-hole pad annular ring"
    (condition "A.Pad_Type == 'Through-hole'")
    (constraint annular_width (min 0.15mm)))

# The preferred via diameter increment is 0.15 mm, or 0.075 mm radially.
(rule "JLC standard via annular ring"
    (condition "A.Type == 'Via'")
    (constraint annular_width (min 0.075mm)))

(rule "JLC pad drill to pad drill"
    (condition "A.Type == 'Pad' && B.Type == 'Pad'")
    (constraint hole_to_hole (min 0.45mm)))

(rule "JLC via drill to via drill"
    (condition "A.Type == 'Via' && B.Type == 'Via'")
    (constraint hole_to_hole (min 0.20mm)))

(rule "JLC via drill to track"
    (condition "A.Type == 'Via' && (B.Type == 'Track' || B.Type == 'Arc')")
    (constraint hole_clearance (min 0.20mm)))

(rule "JLC plated pad drill to track"
    (condition "A.Pad_Type == 'Through-hole' && (B.Type == 'Track' || B.Type == 'Arc')")
    (constraint hole_clearance (min 0.28mm)))

(rule "JLC unplated drill to track"
    (condition "A.Pad_Type == 'NPTH, mechanical' && (B.Type == 'Track' || B.Type == 'Arc')")
    (constraint hole_clearance (min 0.20mm)))

(rule "JLC inner copper to via drill"
    (layer inner)
    (condition "A.Type == 'Via'")
    (constraint hole_clearance (min 0.20mm)))

(rule "JLC inner copper to plated pad drill"
    (layer inner)
    (condition "A.Pad_Type == 'Through-hole'")
    (constraint hole_clearance (min 0.30mm)))

(rule "JLC round NPTH drill size"
    (condition "A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X == A.Hole_Size_Y")
    (constraint hole_size (min 0.50mm)))

(rule "JLC unplated slot width"
    (condition "A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X != A.Hole_Size_Y")
    (constraint hole_size (min 1.00mm)))

(rule "JLC multilayer plated slot width"
    (condition "A.Pad_Type == 'Through-hole' && A.Hole_Size_X != A.Hole_Size_Y")
    (constraint hole_size (min 0.35mm)))

(rule "JLC pad to silkscreen"
    (condition "A.Type == 'Pad' || B.Type == 'Pad'")
    (constraint silk_clearance (min 0.15mm)))

(rule "JLC silkscreen lettering"
    (condition "A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen'")
    (constraint text_height (min 1.00mm))
    (constraint text_thickness (min 0.15mm)))
